erDiagram
    USERS {
        INT id PK
        TEXT username
        TEXT email
        TEXT password
        TEXT first_name
        TEXT last_name
        INT age
        TEXT role
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    PRODUCTS {
        INT id PK
        TEXT name
        TEXT description
        DOUBLE price
        TEXT category
        INT stock
        TEXT[] images
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    BASKETS {
        TEXT id PK
        INT user_id FK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    BASKET_ITEMS {
        TEXT id PK
        TEXT basket_id FK
        INT product_id FK
        INT quantity
    }
    ORDERS {
        TEXT id PK
        INT user_id FK
        TEXT status
        JSON shipping_address
        JSON billing_address
        TEXT payment_method_id
        TEXT notes
        TEXT coupon_code
        DOUBLE total_amount
        DOUBLE discounted_amount
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    ORDER_ITEMS {
        TEXT id PK
        TEXT order_id FK
        INT product_id FK
        INT quantity
        DOUBLE price
    }
    CHECKOUTS {
        TEXT id PK
        INT user_id FK
        TEXT basket_id FK
        TEXT status
        JSON shipping_address
        JSON billing_address
        TEXT payment_method_id
        DOUBLE total
        JSON items
        TEXT order_id
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    WAREHOUSES {
        TEXT id PK
        TEXT name
        TEXT location
        INT capacity
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    INVENTORY {
        TEXT id PK
        INT product_id FK
        TEXT warehouse_id FK
        INT quantity
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    SHIPMENTS {
        TEXT id PK
        TEXT order_id FK
        TEXT sender_name
        TEXT sender_address
        TEXT recipient_name
        TEXT recipient_address
        DOUBLE weight
        JSON dimensions
        TEXT status
        TEXT tracking_number
        TEXT estimated_delivery_date
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    SHIPPING_LABELS {
        TEXT id PK
        TEXT shipment_id FK
        TEXT label_url
        TIMESTAMPTZ created_at
    }
    TRACKING_EVENTS {
        TEXT id PK
        TEXT shipment_id FK
        TEXT status
        TEXT location
        TIMESTAMPTZ created_at
    }
    PICKUP_REQUESTS {
        TEXT id PK
        INT user_id FK
        TEXT pickup_date
        TEXT pickup_address
        TEXT status
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    ADDRESSES {
        TEXT id PK
        INT user_id FK
        TEXT street
        TEXT city
        TEXT state
        TEXT country
        TEXT postal_code
        BOOLEAN is_default
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    PAYMENTS {
        TEXT id PK
        TEXT order_id FK
        INT user_id FK
        TEXT method
        TEXT status
        DOUBLE amount
        TEXT currency
        TEXT notes
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }
    REVIEWS {
        TEXT id PK
        INT product_id FK
        INT user_id FK
        DOUBLE rating
        TEXT comment
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    USERS ||--o{ BASKETS : owns
    USERS ||--o{ ORDERS : places
    USERS ||--o{ CHECKOUTS : performs
    USERS ||--o{ PAYMENTS : makes
    USERS ||--o{ REVIEWS : writes
    USERS ||--o{ PICKUP_REQUESTS : requests
    USERS ||--o{ ADDRESSES : owns

    BASKETS ||--|{ BASKET_ITEMS : contains
    PRODUCTS ||--o{ BASKET_ITEMS : referenced_by
    ORDERS ||--|{ ORDER_ITEMS : contains
    PRODUCTS ||--o{ ORDER_ITEMS : referenced_by

    BASKETS ||--o{ CHECKOUTS : used_by
    ORDERS ||--o{ CHECKOUTS : creates

    PRODUCTS ||--o{ INVENTORY : stocked_in
    WAREHOUSES ||--o{ INVENTORY : stores

    ORDERS ||--o{ PAYMENTS : settles
    ORDERS ||--o{ SHIPMENTS : ships
    SHIPMENTS ||--o{ TRACKING_EVENTS : logs
    SHIPMENTS ||--o{ SHIPPING_LABELS : issues
